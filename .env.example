# Copy this file to .env (local dev) or .env.production (docker build)
# and adjust if your backend runs somewhere other than localhost:8000.
#
# IMPORTANT: this URL is used by the BROWSER, so it must always be a
# host-reachable address (e.g. http://localhost:8000/api), never a
# Docker service/container name.
VITE_API_BASE=http://localhost:8000/api
